#!/usr/bin/env bash
# Blocks commits that stage puzzle inputs or examples (input*.txt, example*.txt).
set -euo pipefail

blocked_files=()
while IFS= read -r -d '' staged_path; do
  file_name="${staged_path##*/}"
  if [[ "$file_name" == input*.txt || "$file_name" == example*.txt ]]; then
    blocked_files+=("$staged_path")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if (( ${#blocked_files[@]} > 0 )); then
  echo "pre-commit: refusing to commit puzzle inputs or examples:" >&2
  printf '  %s\n' "${blocked_files[@]}" >&2
  echo "Unstage them with: git restore --staged <file>" >&2
  exit 1
fi
